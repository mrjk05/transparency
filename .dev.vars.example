# Copy to `.dev.vars` for local `wrangler dev`. `.dev.vars` itself is gitignored — never
# commit real values, particularly JWT_SECRET, which signs every Kadwood Studio session.
#
# MOCK_MODE=true is what makes the app usable without a Shopify admin session: the three
# `/app/*` routes skip authentication when it is set. It cannot leak into production —
# `wrangler deploy` does not upload this file, and because wrangler.toml declares a [vars]
# block, deploying REPLACES the Worker's plain-text vars with exactly that block.
MOCK_MODE=true

# Embedded Shopify app. Only needed to exercise the real embedded path locally.
SHOPIFY_API_KEY=test_api_key
SHOPIFY_API_SECRET=test_api_secret
SHOPIFY_APP_URL=https://example.com
SCOPES=read_all_orders,read_customers,write_customers,read_orders,write_orders

# Kadwood Studio integration. Only needed to exercise /studio/enter locally; must match
# kadwood-ai-backend's values, so take them from your own dev instance, not production.
JWT_SECRET=
STUDIO_ADMIN_SECRET=

# Offline Admin API token — the only way to read orders when the caller arrived through
# Studio and has no id_token to exchange.
SHOPIFY_ADMIN_TOKEN=
